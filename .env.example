# 실제 값은 Vercel 대시보드 환경변수에만 둔다. 이 파일에는 키 이름만 남긴다.

SECRET_KEY=                    # JWT 서명 키
                               # python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=                  # 제공자의 커넥션 풀러 엔드포인트 (9/1 확정)
                               # postgresql+psycopg://USER:PW@HOST.../DB?sslmode=require

AI_MODEL=                      # 확정된 프로바이더의 모델명 (9/1 확정)
AI_API_KEY=                    # 확정된 프로바이더의 키
AI_TIMEOUT_SECONDS=10
AI_CONTEXT_TURNS=5
