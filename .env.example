# 실제 값은 Vercel 대시보드 환경변수에만 둔다. 이 파일에는 키 이름만 남긴다.
#
# 여기 있는 것의 기준: 비밀이거나, 환경마다 달라야 하거나, 운영 중 값을 바꿔야 하는 것.
# 그 셋에 해당하지 않는 값(문맥 턴 수 등)은 config.py 상수로 둔다 — 환경변수 하나는
# 스테이징에 빠뜨릴 수 있는 곳 하나다.

SECRET_KEY=                    # JWT 서명 키
                               # python -c "import secrets;print(secrets.token_hex(32))"
DATABASE_URL=                  # 제공자의 커넥션 풀러 엔드포인트 (9/1 확정)
                               # postgresql+psycopg://USER:PW@HOST.../DB?sslmode=require
AI_API_KEY=                    # OpenAI(코디세이 발급) 키
AI_TIMEOUT_SECONDS=10
